  <Item class="ServerScriptService" referent="223">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="224">
      <Properties>
        <string name="Name">Stage</string>
      </Properties>
      <Item class="Script" referent="225">
        <Properties>
          <string name="Name">Bridge</string>
          <ProtectedString name="Source"><![CDATA[-- Receives join/gift messages from the Node.js TikTok bridge (Open Cloud Messaging Service)
-- and forwards them to the stage queue. Only works in a PUBLISHED game's live servers.
local MessagingService = game:GetService("MessagingService")
local HttpService = game:GetService("HttpService")
local Config = require(script.Parent.Config)
local StageAPI = require(script.Parent.StageAPI)
local ThemeManager = require(script.Parent.ThemeManager)

local MAX_GIFT_REPEAT = 5

local function handle(raw: string)
	local ok, data = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	if not ok or type(data) ~= "table" then
		return
	end

	local by = if type(data.by) == "string" and #data.by <= 50 then data.by else ""

	if data.kind == "join" and type(data.username) == "string" then
		if StageAPI.isValidUsername(data.username) then
			StageAPI.enqueueJoin(data.username, by)
		end
	elseif data.kind == "theme" then
		if ThemeManager.exists(data.name) then
			ThemeManager.apply(data.name)
		end
	elseif data.kind == "gift" and type(data.gift) == "string" and #data.gift <= 50 then
		local count = math.clamp(math.floor(tonumber(data.count) or 1), 1, MAX_GIFT_REPEAT)
		for _ = 1, count do
			StageAPI.enqueueGift(data.gift, by)
		end
	end
end

local ok, err = pcall(function()
	MessagingService:SubscribeAsync(Config.MessagingTopic, function(message)
		handle(message.Data)
	end)
end)

if ok then
	print("[Stage] Listening for bridge messages on topic:", Config.MessagingTopic)
else
	warn("[Stage] Could not subscribe to MessagingService:", err)
end
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="226">
        <Properties>
          <string name="Name">Config</string>
          <ProtectedString name="Source"><![CDATA[-- Central settings. Edit here; no code changes needed for gift tuning.
-- Gift entries are PLACEHOLDERS: rename them to match the real TikTok gift names later.
return {
	-- Stage timing (seconds)
	BaseStayTime = 20, -- how long a joined avatar stays on stage by default
	MaxStayTime = 45, -- hard cap so the stage never freezes
	GiftStayBonus = 5, -- extra seconds added per gift that targets an avatar on stage
	QueueLimit = 15, -- max pending items; extra joins/gifts are dropped
	StageSlots = 3, -- how many avatars can be on stage at once
	ProcessInterval = 0.25, -- how often the queue checks for work

	-- Messages from the Node.js bridge arrive on this topic (must match ROBLOX_TOPIC in bridge/.env)
	MessagingTopic = "TikTokStage",

	-- Gift -> action. Gift names are PLACEHOLDERS: rename them to the real TikTok gift names.
	-- Action (see GiftActions.luau):
	--   Hearts     floating hearts over the newest dancer
	--   Spotlight  a spotlight on the newest dancer        (Seconds)
	--   Giant      the newest dancer grows                 (Seconds, Scale)
	--   Fireworks  fireworks over the whole stage
	--   ThemeSwap  switch the map theme for a while        (Theme, Seconds)
	--   QueueJump  the sender's join goes to the front of the queue
	-- Or use Effect = "Confetti" | "Fire" | "Stars" for a plain particle burst.
	-- Stay = extra seconds added to the newest dancer's time on stage.
	Gifts = {
		Rose = { Action = "Hearts", Stay = 0 }, -- small
		TikTok = { Action = "Spotlight", Seconds = 6, Stay = 0 }, -- small
		Lion = { Action = "Giant", Seconds = 8, Scale = 2, Stay = 5 }, -- medium
		Galaxy = { Action = "Fireworks", Stay = 10 }, -- large
		Universe = { Action = "ThemeSwap", Theme = "DiscoNeon", Seconds = 30, Stay = 0 }, -- large
		Interstellar = { Action = "QueueJump", Stay = 0 }, -- large
	},
	DefaultGift = { Effect = "Confetti", Stay = 0 },
	MaxActiveEffects = 3, -- gifts wait in the queue while this many effects are still playing
	PriorityWindow = 120, -- seconds a QueueJump gift stays valid if the sender has not joined yet

	-- Stage layout. StageOrigin is where the middle avatar's root part stands:
	-- an R15 avatar's feet are about 3 studs lower, so the floor top is StageOrigin.Y - 3.
	StageOrigin = Vector3.new(0, 5, 0),
	SlotSpacing = 8,
	FaceDirection = Vector3.new(0, 0, 1), -- avatars face this way (towards the stream camera)

	-- Map theme applied at game start. Names live in Themes.luau; switch live with /theme <name>.
	Theme = "Halloween",

	-- Dance animations for R15 avatars (a random one per avatar). These are Roblox's standard
	-- emote animations; if one fails to load the avatar falls back to a simple bob.
	DanceAnimations = {
		"rbxassetid://507771019",
		"rbxassetid://507776043",
		"rbxassetid://507777268",
	},
}
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="227">
        <Properties>
          <string name="Name">DevActions</string>
          <ProtectedString name="Source"><![CDATA[-- Developer actions shared by the chat commands and the on-screen DevPanel.
-- Every input is validated here because the panel's RemoteEvent arguments come from a client.
local Config = require(script.Parent.Config)
local StageAPI = require(script.Parent.StageAPI)
local ThemeManager = require(script.Parent.ThemeManager)

local DevActions = {}

-- Returns a short result text.
function DevActions.run(action: any, arg: any, extra: any): string
	if action == "join" then
		if not StageAPI.isValidUsername(arg) then
			return "invalid username"
		end
		return if StageAPI.enqueueJoin(arg, "dev") then "join queued" else "not queued (queue full or already waiting)"
	elseif action == "gift" then
		if type(arg) ~= "string" or #arg == 0 or #arg > 50 then
			return "invalid gift"
		end
		local sender = if type(extra) == "string" and extra ~= "" then extra else "dev"
		return if StageAPI.enqueueGift(arg, sender) then "gift queued" else "queue full"
	elseif action == "theme" then
		if not ThemeManager.exists(arg) then
			return "unknown theme (available: " .. table.concat(ThemeManager.names(), ", ") .. ")"
		end
		ThemeManager.apply(arg :: string)
		return "theme: " .. (arg :: string)
	end
	return "unknown action"
end

-- "Name|Action" labels for the panel's buttons, sorted by name.
function DevActions.giftLabels(): { string }
	local labels = {}
	for _, name in DevActions.giftNames() do
		local rule = Config.Gifts[name]
		table.insert(labels, name .. "|" .. (rule.Action or rule.Effect or "-"))
	end
	return labels
end

-- Gift names from Config.Gifts, sorted (used to build the panel's buttons).
function DevActions.giftNames(): { string }
	local names = {}
	for name in Config.Gifts do
		table.insert(names, name)
	end
	table.sort(names)
	return names
end

return DevActions
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="228">
        <Properties>
          <string name="Name">DevCommands</string>
          <ProtectedString name="Source"><![CDATA[-- Local testing. Accepted only from the game's creator (or anyone inside Studio).
-- Chat commands:   /join <RobloxUsername>   /gift <GiftName> [sender]   /theme <ThemeName>
-- On-screen panel: DevPanel.client.luau fires the StageDevAction remote created below.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DevActions = require(script.Parent.DevActions)
local ThemeManager = require(script.Parent.ThemeManager)

local function allowed(player: Player): boolean
	return RunService:IsStudio() or player.UserId == game.CreatorId
end

local function onChat(player: Player, message: string)
	if not allowed(player) then
		return
	end
	local cmd, arg, extra = message:match("^/(%a+)%s*(%S*)%s*(%S*)")
	if cmd == "join" or cmd == "gift" or cmd == "theme" then
		print("[Dev]", DevActions.run(cmd, arg, extra))
	end
end

local function hook(player: Player)
	player.Chatted:Connect(function(message)
		onChat(player, message)
	end)
end

for _, p in Players:GetPlayers() do
	hook(p)
end
Players.PlayerAdded:Connect(hook)

-- Names for the panel's buttons are published before the remote exists (the panel waits for the remote).
workspace:SetAttribute("StageGiftNames", table.concat(DevActions.giftLabels(), ","))
workspace:SetAttribute("StageThemeNames", table.concat(ThemeManager.names(), ","))

local remote = Instance.new("RemoteEvent")
remote.Name = "StageDevAction"
remote.OnServerEvent:Connect(function(player, action, arg, extra)
	if allowed(player) then
		print("[Dev]", DevActions.run(action, arg, extra))
	end
end)
remote.Parent = ReplicatedStorage
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="229">
        <Properties>
          <string name="Name">Effects</string>
          <ProtectedString name="Source"><![CDATA[-- Visual effects triggered by gifts. Each effect takes a Vector3 position.
local Debris = game:GetService("Debris")

local function burst(position: Vector3, color: Color3, rate: number, life: number)
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(1, 1, 1)
	anchor.Position = position
	anchor.Parent = workspace

	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(color)
	emitter.Rate = 0
	emitter.Lifetime = NumberRange.new(1, 2)
	emitter.Speed = NumberRange.new(8, 16)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Parent = anchor
	emitter:Emit(rate)

	Debris:AddItem(anchor, life)
end

local Effects = {}

-- Generic particle burst, also used by GiftActions (fireworks).
function Effects.Burst(position: Vector3, color: Color3, rate: number, life: number)
	burst(position, color, rate, life)
end

function Effects.Confetti(position: Vector3)
	burst(position, Color3.fromRGB(255, 120, 200), 60, 3)
end

function Effects.Fire(position: Vector3)
	burst(position, Color3.fromRGB(255, 110, 30), 120, 3)
end

function Effects.Stars(position: Vector3)
	burst(position, Color3.fromRGB(255, 240, 150), 80, 3)
end

-- Fallback for unknown effect names
function Effects.Play(name: string, position: Vector3)
	local fn = Effects[name]
	if fn then
		fn(position)
	else
		warn("[Stage] Unknown effect:", name)
	end
end

return Effects
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="230">
        <Properties>
          <string name="Name">GiftActions</string>
          <ProtectedString name="Source"><![CDATA[-- What each gift does on stage. An action starts its own tasks and returns at once.
-- Actions are chosen by `Action = "..."` in Config.Gifts.
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local Config = require(script.Parent.Config)
local Effects = require(script.Parent.Effects)
local Layout = require(script.Parent.Layout)
local StageActor = require(script.Parent.StageActor)
local StageAPI = require(script.Parent.StageAPI)
local ThemeManager = require(script.Parent.ThemeManager)

local GiftActions = {}

----------------------------------------------------------------------------------------------------
-- Limit on effects playing at once. Main leaves gifts in the queue while this is full.
----------------------------------------------------------------------------------------------------
local active = 0

local function track(seconds: number)
	active += 1
	task.delay(seconds, function()
		active = math.max(0, active - 1)
	end)
end

function GiftActions.busy(): boolean
	return active >= Config.MaxActiveEffects
end

----------------------------------------------------------------------------------------------------
-- Helpers
----------------------------------------------------------------------------------------------------
local function fxFolder(): Instance
	local folder = workspace:FindFirstChild("StageFx")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "StageFx"
		folder.Parent = workspace
	end
	return folder
end

-- An invisible anchored part used to hold lights, guis and particles.
local function anchorPart(cframe: CFrame): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Transparency = 1
	part.Size = Vector3.new(1, 1, 1)
	part.CFrame = cframe
	part.Parent = fxFolder()
	return part
end

local FIREWORK_COLORS = {
	Color3.fromRGB(255, 80, 80),
	Color3.fromRGB(255, 200, 60),
	Color3.fromRGB(80, 200, 255),
	Color3.fromRGB(200, 100, 255),
	Color3.fromRGB(120, 255, 140),
}

----------------------------------------------------------------------------------------------------
-- Actions: actions[name](rule, ctx)
-- ctx = { target = newest dancer (Model?), position = Vector3, onStage = { Model }, sender = string }
----------------------------------------------------------------------------------------------------
local actions: { [string]: (any, any) -> () } = {}

function actions.Hearts(_rule, ctx)
	track(3)
	local origin = ctx.position + Vector3.new(0, 4, 0)
	for i = 1, 8 do
		task.delay((i - 1) * 0.15, function()
			local jitter = Vector3.new((math.random() - 0.5) * 4, 0, (math.random() - 0.5) * 2)
			local anchor = anchorPart(CFrame.new(origin + jitter))

			local gui = Instance.new("BillboardGui")
			gui.Size = UDim2.fromOffset(44, 44)
			gui.AlwaysOnTop = true
			gui.Adornee = anchor
			local heart = Instance.new("TextLabel")
			heart.Size = UDim2.fromScale(1, 1)
			heart.BackgroundTransparency = 1
			heart.TextScaled = true
			heart.Text = "♥"
			heart.TextColor3 = Color3.fromRGB(255, 80, 140)
			heart.Parent = gui
			gui.Parent = anchor

			TweenService:Create(gui, TweenInfo.new(2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { StudsOffset = Vector3.new(0, 8, 0) }):Play()
			TweenService:Create(heart, TweenInfo.new(2), { TextTransparency = 1 }):Play()
			Debris:AddItem(anchor, 2.2)
		end)
	end
end

function actions.Spotlight(rule, ctx)
	local seconds = rule.Seconds or 6
	track(seconds)
	local target = ctx.position
	local lamp = anchorPart(CFrame.lookAt(target + Vector3.new(0, 16, 12), target))
	local light = Instance.new("SpotLight")
	light.Face = Enum.NormalId.Front
	light.Angle = 40
	light.Range = 50
	light.Brightness = 8
	light.Color = Color3.fromRGB(255, 240, 200)
	light.Shadows = false
	light.Parent = lamp
	Debris:AddItem(lamp, seconds)
end

function actions.Giant(rule, ctx)
	local model = ctx.target
	if not model then
		return -- nobody on stage to grow
	end
	local scale = rule.Scale or 2
	local seconds = rule.Seconds or 8
	track(seconds + 1)
	task.spawn(function()
		local steps = 6
		for step = 1, steps do -- grow smoothly
			if not model.Parent then
				return
			end
			StageActor.setScale(model, 1 + (scale - 1) * step / steps)
			task.wait(0.05)
		end
		task.wait(seconds)
		for step = steps - 1, 0, -1 do -- shrink back
			if not model.Parent then
				return
			end
			StageActor.setScale(model, 1 + (scale - 1) * step / steps)
			task.wait(0.05)
		end
	end)
end

function actions.Fireworks(_rule, _ctx)
	track(5)
	local floorY = Layout.floorTopY()
	for i = 1, 6 do
		task.delay((i - 1) * 0.5, function()
			local angle = math.random() * math.pi * 2
			local start = Vector3.new(Config.StageOrigin.X + math.cos(angle) * 14, floorY + 1, Config.StageOrigin.Z + math.sin(angle) * 10 - 8)
			local top = start + Vector3.new(0, 30 + math.random() * 10, 0)
			local color = FIREWORK_COLORS[math.random(1, #FIREWORK_COLORS)]

			local rocket = anchorPart(CFrame.new(start))
			rocket.Size = Vector3.new(0.5, 2, 0.5)
			rocket.Transparency = 0
			rocket.Color = color
			rocket.Material = Enum.Material.Neon
			TweenService:Create(rocket, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Position = top }):Play()

			task.delay(0.8, function()
				rocket.Transparency = 1
				local flash = Instance.new("PointLight")
				flash.Brightness = 8
				flash.Range = 70
				flash.Color = color
				flash.Shadows = false
				flash.Parent = rocket
				TweenService:Create(flash, TweenInfo.new(0.6), { Brightness = 0 }):Play()
				Effects.Burst(top, color, 140, 3)
				Debris:AddItem(rocket, 1)
			end)
		end)
	end
end

-- Theme swap: the first swap remembers the theme to return to; later swaps only extend the time.
local swap = { token = 0, base = nil :: string?, endsAt = 0 }

function actions.ThemeSwap(rule, _ctx)
	local theme, seconds = rule.Theme, rule.Seconds or 30
	if not ThemeManager.exists(theme) then
		warn("[Stage] ThemeSwap: unknown theme", theme)
		return
	end
	swap.token += 1
	local token = swap.token
	if swap.base == nil then
		swap.base = ThemeManager.current
	end
	swap.endsAt = os.clock() + seconds
	if ThemeManager.current ~= theme then
		ThemeManager.apply(theme)
	end
	task.spawn(function()
		while os.clock() < swap.endsAt do
			task.wait(1)
		end
		if token ~= swap.token then
			return -- a newer swap took over
		end
		local base = swap.base
		swap.base = nil
		-- Restore only if nobody changed the theme by hand in the meantime
		if base and ThemeManager.current == theme then
			ThemeManager.apply(base)
		end
	end)
end

function actions.QueueJump(_rule, ctx)
	local sender = ctx.sender
	if sender ~= "" then
		StageAPI.promote(sender)
	end
	-- Free a slot sooner: the dancer with the least time left gets at most 5 more seconds
	if #ctx.onStage >= Config.StageSlots then
		local soonest
		for _, model in ctx.onStage do
			if model.Parent and (soonest == nil or StageActor.remaining(model) < StageActor.remaining(soonest)) then
				soonest = model
			end
		end
		if soonest then
			StageActor.setStay(soonest, math.min(StageActor.remaining(soonest), 5))
		end
	end
	Effects.Play("Stars", ctx.position)
end

----------------------------------------------------------------------------------------------------
-- Entry point
----------------------------------------------------------------------------------------------------
function GiftActions.run(rule, ctx)
	local action = rule.Action and actions[rule.Action]
	if action then
		action(rule, ctx)
	elseif rule.Action then
		warn("[Stage] Unknown gift action:", rule.Action)
	elseif rule.Effect then
		Effects.Play(rule.Effect, ctx.position)
	end
end

function GiftActions.names(): { string }
	local list = {}
	for name in actions do
		table.insert(list, name)
	end
	table.sort(list)
	return list
end

return GiftActions
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="231">
        <Properties>
          <string name="Name">GiftQueue</string>
          <ProtectedString name="Source"><![CDATA[-- FIFO queue with a hard size limit. Items: { kind = "join" | "gift", ... }
local GiftQueue = {}
GiftQueue.__index = GiftQueue

function GiftQueue.new(limit: number)
	return setmetatable({ items = {}, limit = limit }, GiftQueue)
end

function GiftQueue:push(item): boolean
	if #self.items >= self.limit then
		return false -- queue full, drop it
	end
	table.insert(self.items, item)
	return true
end

function GiftQueue:pop(): any?
	if #self.items == 0 then
		return nil
	end
	return table.remove(self.items, 1)
end

function GiftQueue:size(): number
	return #self.items
end

return GiftQueue
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="232">
        <Properties>
          <string name="Name">Layout</string>
          <ProtectedString name="Source"><![CDATA[-- Shared stage geometry so avatars, the map and the camera always agree.
local Config = require(script.Parent.Config)

local Layout = {}

-- Distance from an R15 root part to the soles of its feet (HipHeight 2 + half of the 2-stud root).
local ROOT_TO_FEET = 3
Layout.ROOT_TO_FEET = ROOT_TO_FEET

function Layout.floorTopY(): number
	return Config.StageOrigin.Y - ROOT_TO_FEET
end

function Layout.slotPosition(slot: number): Vector3
	local offset = (slot - (Config.StageSlots + 1) / 2) * Config.SlotSpacing
	return Config.StageOrigin + Vector3.new(offset, 0, 0)
end

-- Offset relative to the stage centre on the floor (y = 0 means standing on the floor).
function Layout.fromFloor(offset: Vector3): Vector3
	return Vector3.new(Config.StageOrigin.X + offset.X, Layout.floorTopY() + offset.Y, Config.StageOrigin.Z + offset.Z)
end

-- Offset relative to StageOrigin itself (used for camera positions).
function Layout.fromOrigin(offset: Vector3): Vector3
	return Config.StageOrigin + offset
end

return Layout
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="Script" referent="233">
        <Properties>
          <string name="Name">Main</string>
          <ProtectedString name="Source"><![CDATA[-- Main loop: takes items from the queue, spawns avatars, plays gift effects.
local Config = require(script.Parent.Config)
local StageAPI = require(script.Parent.StageAPI)
local StageActor = require(script.Parent.StageActor)
local Effects = require(script.Parent.Effects)
local ThemeManager = require(script.Parent.ThemeManager)
local GiftActions = require(script.Parent.GiftActions)

local queue = StageAPI.getQueue()
local onStage: { Model } = {}

local function cleanupStage()
	for i = #onStage, 1, -1 do
		local model = onStage[i]
		if StageActor.isExpired(model) then
			model:Destroy()
		end
		if not model.Parent then
			table.remove(onStage, i)
		end
	end
end

local function freeSlot(): number?
	for slot = 1, Config.StageSlots do
		local taken = false
		for _, m in onStage do
			if m:GetAttribute("Slot") == slot then
				taken = true
				break
			end
		end
		if not taken then
			return slot
		end
	end
	return nil
end

local function handleJoin(item)
	if StageActor.isOnStage(item.username) then
		print("[Stage] Already on stage, skipped:", item.username)
		return true -- consumed
	end
	local slot = freeSlot()
	if not slot then
		-- No slot yet: put the join back at the front and wait
		return false
	end
	local model, reason = StageActor.spawn(item.username, slot)
	if not model then
		warn("[Stage] Join failed for", item.username, reason)
		return true -- consumed, skip it
	end
	model:SetAttribute("Slot", slot)
	table.insert(onStage, model)
	StageActor.setStay(model, Config.BaseStayTime)
	Effects.Play("Confetti", model:GetPivot().Position)
	return true
end

local function handleGift(item)
	local rule = Config.Gifts[item.gift] or Config.DefaultGift
	if rule.Action and GiftActions.busy() then
		return false -- too many effects playing: keep the gift in the queue until one finishes
	end
	cleanupStage()
	local target = onStage[#onStage]
	local pos = target and target:GetPivot().Position or Config.StageOrigin
	GiftActions.run(rule, { target = target, position = pos, onStage = onStage, sender = item.sender or "" })
	if target and rule.Stay > 0 then
		local current = math.max(0, (target:GetAttribute("LeaveAt") or os.clock()) - os.clock())
		local extra = math.min(current + rule.Stay + Config.GiftStayBonus, Config.MaxStayTime)
		StageActor.setStay(target, extra)
	end
	return true
end

ThemeManager.apply(Config.Theme)

task.spawn(function()
	while true do
		cleanupStage()
		local item = queue.items[1]
		if item then
			local done
			if item.kind == "join" then
				done = handleJoin(item)
			else
				done = handleGift(item)
			end
			if done then
				queue:pop()
			end
		end
		task.wait(Config.ProcessInterval)
	end
end)

print("[Stage] Ready. Queue limit:", Config.QueueLimit)
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="234">
        <Properties>
          <string name="Name">StageAPI</string>
          <ProtectedString name="Source"><![CDATA[-- Single entry point for the queue. The TikTok bridge (later) and dev commands both call this.
local GiftQueue = require(script.Parent.GiftQueue)
local Config = require(script.Parent.Config)

local queue = GiftQueue.new(Config.QueueLimit)

local StageAPI = {}

-- Sender -> time until which their next join goes to the front (set by a QueueJump gift).
local priority: { [string]: number } = {}

-- Returns false when the queue is full or this username is already waiting in it.
-- `by` is the TikTok viewer who asked; a viewer with a QueueJump gift jumps to the front.
function StageAPI.enqueueJoin(username: string, by: string?): boolean
	local wanted = string.lower(username)
	for _, item in queue.items do
		if item.kind == "join" and string.lower(item.username) == wanted then
			return false
		end
	end
	local item = { kind = "join", username = username, by = by or "" }
	if by and by ~= "" and (priority[by] or 0) > os.clock() then
		priority[by] = nil
		if #queue.items >= Config.QueueLimit then
			return false
		end
		table.insert(queue.items, 1, item)
		return true
	end
	return queue:push(item)
end

-- Moves the sender's waiting join to the front. If they have none yet, their next join goes first.
-- Returns true when an existing join was moved.
function StageAPI.promote(sender: string): boolean
	for i, item in queue.items do
		if item.kind == "join" and item.by == sender then
			table.remove(queue.items, i)
			table.insert(queue.items, 1, item)
			return true
		end
	end
	priority[sender] = os.clock() + Config.PriorityWindow
	return false
end

function StageAPI.enqueueGift(giftName: string, sender: string?): boolean
	return queue:push({ kind = "gift", gift = giftName, sender = sender or "" })
end

-- Roblox usernames: 3-20 characters, letters/digits/underscore only.
function StageAPI.isValidUsername(name: any): boolean
	return type(name) == "string" and #name >= 3 and #name <= 20 and name:match("^[%w_]+$") ~= nil
end

function StageAPI.getQueue()
	return queue
end

return StageAPI
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="235">
        <Properties>
          <string name="Name">StageActor</string>
          <ProtectedString name="Source"><![CDATA[-- Spawns an NPC that copies a Roblox user's avatar, dances on its stage slot, and is removed later.
local Players = game:GetService("Players")
local Config = require(script.Parent.Config)
local Layout = require(script.Parent.Layout)

local StageActor = {}

local function facing(position: Vector3): CFrame
	return CFrame.lookAt(position, position + Config.FaceDirection)
end

-- Plays a random dance animation. If none can be loaded the avatar bobs instead.
local function startDancing(model: Model, humanoid: Humanoid, position: Vector3)
	task.spawn(function()
		local ids = Config.DanceAnimations
		if #ids > 0 then
			local animator = humanoid:FindFirstChildOfClass("Animator")
			if not animator then
				animator = Instance.new("Animator")
				animator.Parent = humanoid
			end
			local animation = Instance.new("Animation")
			animation.AnimationId = ids[math.random(1, #ids)]
			local ok, track = pcall(function()
				return (animator :: Animator):LoadAnimation(animation)
			end)
			if ok and track then
				track.Looped = true
				track:Play()
				task.wait(1)
				if not model.Parent then
					return
				end
				if track.Length > 0 then
					return -- the animation loaded and is playing
				end
				track:Stop()
			end
		end

		local t = 0
		while model.Parent do
			t += task.wait(0.03)
			local lift = model:GetAttribute("YOffset") or 0 -- raised when the avatar is scaled up
			model:PivotTo(facing(position + Vector3.new(0, lift + math.sin(t * 4) * 0.5, 0)))
		end
	end)
end

-- Returns the model, or nil + reason if the username cannot be resolved.
function StageActor.spawn(username: string, slot: number): (Model?, string?)
	local okId, userId = pcall(function()
		return Players:GetUserIdFromNameAsync(username)
	end)
	if not okId then
		return nil, "username not found"
	end

	local okDesc, description = pcall(function()
		return Players:GetHumanoidDescriptionFromUserId(userId)
	end)
	if not okDesc then
		return nil, "could not load avatar"
	end

	local model = Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	model.Name = username
	model:SetAttribute("StageActor", true)
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid then
		model:Destroy()
		return nil, "avatar has no humanoid"
	end
	model.PrimaryPart = root
	-- Anchor only the root: the limbs follow through their joints, so animations can still move them.
	root.Anchored = true
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff

	-- Nametag
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(140, 26)
	gui.StudsOffset = Vector3.new(0, 3, 0)
	gui.AlwaysOnTop = true
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0
	label.Text = username
	label.Parent = gui
	gui.Parent = root

	local position = Layout.slotPosition(slot)
	model:SetAttribute("SlotPos", position)
	model:PivotTo(facing(position))
	model.Parent = workspace
	startDancing(model, humanoid, position)

	return model, nil
end

-- Scales the avatar (1 = normal) and lifts it so its feet stay on the floor.
function StageActor.setScale(model: Model, scale: number)
	local slotPos = model:GetAttribute("SlotPos")
	if typeof(slotPos) ~= "Vector3" then
		return
	end
	local lift = Layout.ROOT_TO_FEET * (scale - 1)
	model:SetAttribute("YOffset", lift)
	model:ScaleTo(scale)
	model:PivotTo(facing(slotPos + Vector3.new(0, lift, 0)))
end

-- True when this username is already dancing on the stage (case-insensitive).
function StageActor.isOnStage(username: string): boolean
	local wanted = string.lower(username)
	for _, child in workspace:GetChildren() do
		if child:GetAttribute("StageActor") and string.lower(child.Name) == wanted then
			return true
		end
	end
	return false
end

-- Sets an expiry time. Calling again replaces it, so gifts can extend the stay.
-- Main.server.luau removes avatars once their LeaveAt time has passed.
function StageActor.setStay(model: Model, seconds: number)
	model:SetAttribute("LeaveAt", os.clock() + seconds)
end

-- Seconds left on stage (0 when expired or when no stay time was set).
function StageActor.remaining(model: Model): number
	local leaveAt = model:GetAttribute("LeaveAt")
	if leaveAt == nil then
		return math.huge
	end
	return math.max(0, leaveAt - os.clock())
end

function StageActor.isExpired(model: Model): boolean
	local leaveAt = model:GetAttribute("LeaveAt")
	return leaveAt ~= nil and os.clock() >= leaveAt
end

return StageActor
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="236">
        <Properties>
          <string name="Name">ThemeManager</string>
          <ProtectedString name="Source"><![CDATA[-- Builds the stage map from a theme in Themes.luau. Safe to call again to switch themes.
-- In Studio (edit mode) run this in the Command Bar to preview a theme:
--   require(game.ServerScriptService.Stage.ThemeManager).apply("Halloween")
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Config = require(script.Parent.Config)
local Layout = require(script.Parent.Layout)
local Themes = require(script.Parent.Themes)

local MAP_NAME = "StageMap"
local ATMOSPHERE_NAME = "StageAtmosphere"
local BLOOM_NAME = "StageBloom"
local COLOR_NAME = "StageColor"
local DEPTH_NAME = "StageDepth"

local ThemeManager = {}
ThemeManager.current = nil :: string?

----------------------------------------------------------------------------------------------------
-- Part helpers
----------------------------------------------------------------------------------------------------

local function newPart(parent: Instance, props): Part
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanTouch = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in props do
		(part :: any)[key] = value
	end
	part.Parent = parent
	return part
end

-- A cylinder whose long axis runs from point a to point b.
local function cylinderBetween(parent: Instance, a: Vector3, b: Vector3, diameter: number, props)
	local delta = b - a
	local center = (a + b) / 2
	local cf
	if math.abs(delta.Unit.Y) > 0.999 then
		cf = CFrame.new(center) * CFrame.Angles(0, 0, math.pi / 2) -- vertical
	else
		cf = CFrame.lookAt(center, b) * CFrame.Angles(0, math.pi / 2, 0)
	end
	local full = { Shape = Enum.PartType.Cylinder, Size = Vector3.new(delta.Magnitude, diameter, diameter), CFrame = cf }
	for key, value in props do
		full[key] = value
	end
	return newPart(parent, full)
end

local function light(className: string, parent: Instance, props)
	local l = Instance.new(className)
	for key, value in props do
		(l :: any)[key] = value
	end
	l.Parent = parent
	return l
end

----------------------------------------------------------------------------------------------------
-- Prop builders: builders[kind](parent, prop)
----------------------------------------------------------------------------------------------------

local builders: { [string]: (Instance, any) -> () } = {}

function builders.Pumpkin(parent, prop)
	local s = prop.scale or 1
	local center = Layout.fromFloor(prop.pos) + Vector3.new(0, 2 * s, 0)
	local orange = Color3.fromRGB(240, 110, 20)
	newPart(parent, {
		Name = "Pumpkin",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(4, 4, 4) * s,
		CFrame = CFrame.new(center),
		Color = orange,
		Material = Enum.Material.SmoothPlastic,
	})
	newPart(parent, {
		Name = "Stem",
		Size = Vector3.new(0.5, 1, 0.5) * s,
		CFrame = CFrame.new(center + Vector3.new(0, 2.1 * s, 0)),
		Color = Color3.fromRGB(70, 45, 20),
		Material = Enum.Material.Wood,
	})
	-- Carved face on the +Z side (towards the camera); the mouth carries the glow
	local glow = Color3.fromRGB(255, 200, 60)
	for _, x in { -0.8, 0.8 } do
		newPart(parent, {
			Name = "Eye",
			Size = Vector3.new(0.6, 0.6, 0.4) * s,
			CFrame = CFrame.new(center + Vector3.new(x * s, 0.5 * s, 1.76 * s)),
			Color = glow,
			Material = Enum.Material.Neon,
		})
	end
	local mouth = newPart(parent, {
		Name = "Mouth",
		Size = Vector3.new(1.6, 0.4, 0.4) * s,
		CFrame = CFrame.new(center + Vector3.new(0, -0.7 * s, 1.87 * s)),
		Color = glow,
		Material = Enum.Material.Neon,
	})
	light("PointLight", mouth, { Brightness = 2, Range = 12 * s, Color = Color3.fromRGB(255, 150, 50), Shadows = false })
end

function builders.Candle(parent, prop)
	local s = prop.scale or 1
	local base = Layout.fromFloor(prop.pos)
	local height = 2.5 * s
	cylinderBetween(parent, base, base + Vector3.new(0, height, 0), 0.8 * s, {
		Name = "Candle",
		Color = Color3.fromRGB(240, 235, 215),
		Material = Enum.Material.SmoothPlastic,
	})
	local flame = newPart(parent, {
		Name = "Flame",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(0.6, 0.6, 0.6) * s,
		CFrame = CFrame.new(base + Vector3.new(0, height + 0.3 * s, 0)),
		Color = Color3.fromRGB(255, 170, 60),
		Material = Enum.Material.Neon,
	})
	light("PointLight", flame, { Brightness = 1.5, Range = 10, Color = Color3.fromRGB(255, 170, 80), Shadows = false })
end

function builders.Pillar(parent, prop)
	local base = Layout.fromFloor(prop.pos)
	local height = prop.height or 16
	local radius = prop.radius or 1.5
	cylinderBetween(parent, base, base + Vector3.new(0, height, 0), radius * 2, {
		Name = "Pillar",
		Color = prop.color or Color3.fromRGB(70, 70, 85),
		Material = if prop.neon then Enum.Material.Neon else Enum.Material.Concrete,
	})
	if not prop.neon then
		cylinderBetween(parent, base + Vector3.new(0, height, 0), base + Vector3.new(0, height + 0.8, 0), radius * 2.8, {
			Name = "PillarCap",
			Color = prop.color or Color3.fromRGB(70, 70, 85),
			Material = Enum.Material.Concrete,
		})
	end
end

function builders.DeadTree(parent, prop)
	local s = prop.scale or 1
	local base = Layout.fromFloor(prop.pos)
	local bark = { Color = Color3.fromRGB(50, 35, 25), Material = Enum.Material.Wood }
	cylinderBetween(parent, base, base + Vector3.new(0, 12 * s, 0), 1.6 * s, { Name = "Trunk", Color = bark.Color, Material = bark.Material })
	-- { height fraction on trunk, yaw (radians), branch length }
	for _, b in { { 0.4, 3.6, 4 }, { 0.55, 0.3, 6 }, { 0.7, 2.4, 5 }, { 0.85, 4.2, 4.5 } } do
		local attach = base + Vector3.new(0, 12 * s * b[1], 0)
		local direction = Vector3.new(math.cos(b[2]) * 0.8, 0.6, math.sin(b[2]) * 0.8).Unit
		cylinderBetween(parent, attach, attach + direction * b[3] * s, 0.7 * s, { Name = "Branch", Color = bark.Color, Material = bark.Material })
	end
end

function builders.Moon(parent, prop)
	local size = prop.size or 40
	newPart(parent, {
		Name = "Moon",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(size, size, size),
		CFrame = CFrame.new(Layout.fromFloor(prop.pos)),
		Color = prop.color or Color3.fromRGB(255, 245, 200),
		Material = Enum.Material.Neon,
		CastShadow = false,
	})
end

function builders.Spotlight(parent, prop)
	local pos = Layout.fromFloor(prop.pos)
	local target = Layout.fromFloor(prop.aim or Vector3.new(0, 2, 0))
	local housing = newPart(parent, {
		Name = "Spotlight",
		Size = Vector3.new(1.4, 1.4, 2),
		CFrame = CFrame.lookAt(pos, target),
		Color = Color3.fromRGB(25, 25, 30),
		Material = Enum.Material.Metal,
	})
	light("SpotLight", housing, {
		Face = Enum.NormalId.Front,
		Angle = prop.angle or 60,
		Range = prop.range or 60,
		Brightness = prop.brightness or 4,
		Color = prop.color or Color3.new(1, 1, 1),
		Shadows = prop.shadows ~= false, -- real shadows when the place uses Future lighting
	})
end

function builders.NeonTile(parent, prop)
	local size = prop.size or 3
	newPart(parent, {
		Name = "NeonTile",
		Size = Vector3.new(size, 0.2, size),
		CFrame = CFrame.new(Layout.fromFloor(prop.pos) + Vector3.new(0, 0.1, 0)),
		Color = prop.color or Color3.new(1, 1, 1),
		Material = Enum.Material.Neon,
	})
end

function builders.Gravestone(parent, prop)
	local s = prop.scale or 1
	local frame = CFrame.new(Layout.fromFloor(prop.pos)) * CFrame.Angles(0, prop.yaw or 0, prop.tilt or 0)
	local stone = { Color = Color3.fromRGB(95, 95, 108), Material = Enum.Material.Slate }
	newPart(parent, {
		Name = "Gravestone",
		Size = Vector3.new(2.4, 3.2, 0.8) * s,
		CFrame = frame * CFrame.new(0, 1.6 * s, 0),
		Color = stone.Color,
		Material = stone.Material,
	})
	-- Rounded top: a cylinder as wide as the slab, lying along the slab's thickness
	newPart(parent, {
		Name = "GravestoneTop",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.8, 2.4, 2.4) * s,
		CFrame = frame * CFrame.new(0, 3.2 * s, 0) * CFrame.Angles(0, math.pi / 2, 0),
		Color = stone.Color,
		Material = stone.Material,
	})
end

function builders.Fence(parent, prop)
	local from, to = Layout.fromFloor(prop.pos), Layout.fromFloor(prop.to)
	local height = prop.height or 5
	local up = Vector3.new(0, height, 0)
	local iron = { Color = Color3.fromRGB(25, 25, 30), Material = Enum.Material.Metal }
	local posts = math.max(2, math.floor((to - from).Magnitude / 3) + 1)
	for i = 0, posts - 1 do
		local p = from + (to - from) * (i / (posts - 1))
		cylinderBetween(parent, p, p + up, 0.4, { Name = "FencePost", Color = iron.Color, Material = iron.Material })
	end
	for _, fraction in { 0.45, 0.85 } do
		local lift = Vector3.new(0, height * fraction, 0)
		cylinderBetween(parent, from + lift, to + lift, 0.25, { Name = "FenceRail", Color = iron.Color, Material = iron.Material })
	end
end

function builders.Mist(parent, prop)
	local size = prop.size or Vector3.new(40, 2, 30)
	local part = newPart(parent, {
		Name = "Mist",
		Size = size,
		CFrame = CFrame.new(Layout.fromFloor(prop.pos) + Vector3.new(0, size.Y / 2, 0)),
		Transparency = 1,
	})
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(prop.color or Color3.fromRGB(150, 110, 220))
	emitter.Size = NumberSequence.new(14)
	emitter.Transparency = NumberSequence.new(0.85, 1)
	emitter.Lifetime = NumberRange.new(6, 9)
	emitter.Speed = NumberRange.new(0.3, 0.8)
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.Rate = prop.rate or 6
	emitter.LightEmission = 0.15
	emitter.Parent = part
end

-- A glowing circle drawn on the floor from short neon segments.
function builders.RingLine(parent, prop)
	local radius = prop.radius or 10
	local count = prop.segments or 36
	local length = 2 * math.pi * radius / count * 1.06
	for i = 1, count do
		local theta = (i - 1) / count * math.pi * 2
		local at = Layout.fromFloor(Vector3.new(math.cos(theta) * radius, 0.03, math.sin(theta) * radius))
		newPart(parent, {
			Name = "RingLine",
			Size = Vector3.new(length, 0.06, prop.width or 0.25),
			CFrame = CFrame.new(at) * CFrame.Angles(0, -(theta + math.pi / 2), 0), -- long side runs along the circle
			Color = prop.color or Color3.new(1, 1, 1),
			Material = Enum.Material.Neon,
			Transparency = prop.transparency or 0.25,
		})
	end
end

function builders.DiscoBall(parent, prop)
	local size = prop.size or 6
	local center = Layout.fromFloor(prop.pos)
	local core = newPart(parent, {
		Name = "DiscoBall",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(size, size, size),
		CFrame = CFrame.new(center),
		Color = Color3.fromRGB(190, 190, 210),
		Material = Enum.Material.Metal,
		Reflectance = 0.4,
	})
	-- Mirror facets spread over the sphere (Fibonacci lattice)
	local facetColors = { Color3.new(1, 1, 1), Color3.fromRGB(255, 150, 230), Color3.fromRGB(150, 255, 245) }
	local count = 60
	for i = 1, count do
		local y = 1 - (i - 0.5) * 2 / count
		local ring = math.sqrt(1 - y * y)
		local theta = i * 2.399963
		local direction = Vector3.new(math.cos(theta) * ring, y, math.sin(theta) * ring)
		local at = center + direction * (size / 2)
		newPart(parent, {
			Name = "Facet",
			Size = Vector3.new(size * 0.14, size * 0.14, size * 0.05),
			CFrame = CFrame.lookAt(at, at + direction),
			Color = facetColors[i % #facetColors + 1],
			Material = Enum.Material.Neon,
		})
	end
	-- Slowly cycling coloured glow (property changes only, so it is cheap to replicate)
	local glow = light("PointLight", core, { Brightness = 2, Range = 40, Color = facetColors[2], Shadows = false })
	if RunService:IsRunning() then
		task.spawn(function()
			local palette = { Color3.fromRGB(255, 0, 170), Color3.fromRGB(0, 255, 230), Color3.fromRGB(255, 230, 0) }
			local index = 1
			while glow.Parent do
				index = index % #palette + 1
				TweenService:Create(glow, TweenInfo.new(1.5), { Color = palette[index] }):Play()
				task.wait(1.5)
			end
		end)
	end
end

----------------------------------------------------------------------------------------------------
-- Map pieces
----------------------------------------------------------------------------------------------------

local function buildGround(map: Instance, theme)
	local groundTop = Layout.floorTopY() - theme.Floor.Thickness
	newPart(map, {
		Name = "Ground",
		Size = Vector3.new(500, 1, 500),
		CFrame = CFrame.new(Config.StageOrigin.X, groundTop - 0.5, Config.StageOrigin.Z),
		Color = theme.Ground.Color,
		Material = theme.Ground.Material,
		CanCollide = true,
	})
end

local function buildFloor(map: Instance, theme)
	local floor = theme.Floor
	local top = Layout.floorTopY()
	local cx, cz = Config.StageOrigin.X, Config.StageOrigin.Z
	local upright = CFrame.Angles(0, 0, math.pi / 2) -- cylinders lie along X by default
	newPart(map, {
		Name = "Floor",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(floor.Thickness, floor.Radius * 2, floor.Radius * 2),
		CFrame = CFrame.new(cx, top - floor.Thickness / 2, cz) * upright,
		Color = floor.Color,
		Material = floor.Material,
		CanCollide = true,
	})
	-- Glowing rim: a slightly larger, thin disc just under the floor surface
	newPart(map, {
		Name = "FloorRim",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, floor.Radius * 2 + 1.2, floor.Radius * 2 + 1.2),
		CFrame = CFrame.new(cx, top - 0.25, cz) * upright,
		Color = floor.RingColor,
		Material = Enum.Material.Neon,
	})
	-- A marker where each avatar will stand
	for slot = 1, Config.StageSlots do
		local at = Layout.slotPosition(slot)
		newPart(map, {
			Name = "SlotMarker" .. slot,
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.1, 5, 5),
			CFrame = CFrame.new(at.X, top + 0.05, at.Z) * upright,
			Color = floor.RingColor,
			Material = Enum.Material.Neon,
			Transparency = 0.4,
		})
	end
end

local function applyLighting(theme)
	for key, value in theme.Lighting do
		(Lighting :: any)[key] = value
	end
	Lighting.GlobalShadows = true

	for _, name in { ATMOSPHERE_NAME, BLOOM_NAME, COLOR_NAME, DEPTH_NAME } do
		local old = Lighting:FindFirstChild(name)
		if old then
			old:Destroy()
		end
	end
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Name = ATMOSPHERE_NAME
	for key, value in theme.Atmosphere do
		(atmosphere :: any)[key] = value
	end
	atmosphere.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Name = BLOOM_NAME
	for key, value in theme.Bloom do
		(bloom :: any)[key] = value
	end
	bloom.Parent = Lighting

	if theme.ColorCorrection then
		local color = Instance.new("ColorCorrectionEffect")
		color.Name = COLOR_NAME
		for key, value in theme.ColorCorrection do
			(color :: any)[key] = value
		end
		color.Parent = Lighting
	end
	if theme.Depth then
		local depth = Instance.new("DepthOfFieldEffect")
		depth.Name = DEPTH_NAME
		for key, value in theme.Depth do
			(depth :: any)[key] = value
		end
		depth.Parent = Lighting
	end
end

-- The client camera script reads these attributes (see StreamCamera.client.luau).
local function publishCamera(name: string, theme)
	local camera = theme.Camera
	workspace:SetAttribute("StageTheme", name)
	workspace:SetAttribute("StageCamPos", Layout.fromOrigin(camera.Pos))
	workspace:SetAttribute("StageCamLook", Layout.fromOrigin(camera.Look))
	workspace:SetAttribute("StageCamFov", camera.Fov or 50)
	workspace:SetAttribute("StageCamOrbit", camera.Orbit or false)
end

----------------------------------------------------------------------------------------------------
-- Public API
----------------------------------------------------------------------------------------------------

function ThemeManager.names(): { string }
	local list = {}
	for name in Themes do
		table.insert(list, name)
	end
	table.sort(list)
	return list
end

function ThemeManager.exists(name: any): boolean
	return type(name) == "string" and Themes[name] ~= nil
end

-- Returns true when the theme was applied.
function ThemeManager.apply(name: string): boolean
	local theme = Themes[name]
	if not theme then
		warn("[Stage] Unknown theme:", name, "- available:", table.concat(ThemeManager.names(), ", "))
		return false
	end

	local old = workspace:FindFirstChild(MAP_NAME)
	if old then
		old:Destroy()
	end
	local map = Instance.new("Folder")
	map.Name = MAP_NAME

	buildGround(map, theme)
	buildFloor(map, theme)
	for _, prop in theme.Props do
		local build = builders[prop.kind]
		if not build then
			warn("[Stage] Unknown prop kind:", prop.kind)
		else
			local ok, err = pcall(build, map, prop)
			if not ok then
				warn("[Stage] Prop failed:", prop.kind, err)
			end
		end
	end
	map.Parent = workspace

	applyLighting(theme)
	publishCamera(name, theme)
	ThemeManager.current = name
	print("[Stage] Theme applied:", name)
	return true
end

return ThemeManager
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="237">
        <Properties>
          <string name="Name">Themes</string>
          <ProtectedString name="Source"><![CDATA[-- Map themes: pure data. To add a theme, copy one block and change the values.
-- Positions in Props are offsets from the stage centre; y = 0 means "on the floor".
-- Prop kinds (see ThemeManager.luau): Pumpkin, Candle, Pillar, DeadTree, Gravestone, Fence, Mist,
-- RingLine, Moon, Spotlight, NeonTile, DiscoBall.
-- Optional per theme: ColorCorrection = { Saturation, Contrast, TintColor }, Depth = { FarIntensity, FocusDistance, InFocusRadius, NearIntensity }.
-- Camera positions are offsets from Config.StageOrigin.
local V3 = Vector3.new
local RGB = Color3.fromRGB

local function add(list, prop)
	table.insert(list, prop)
end

-- Ring of neon floor tiles, colours cycling through `colors`.
local function neonRing(list, count: number, radius: number, colors, size: number, phase: number?)
	for i = 1, count do
		local angle = (i - 1) / count * math.pi * 2 + (phase or 0)
		add(list, {
			kind = "NeonTile",
			pos = V3(math.cos(angle) * radius, 0, math.sin(angle) * radius),
			size = size,
			color = colors[(i - 1) % #colors + 1],
		})
	end
end

local Themes = {}

----------------------------------------------------------------------------------------------------
-- Halloween: purple marble stage, pumpkins, candles, dead trees under a full moon
----------------------------------------------------------------------------------------------------
do
	local props = {}
	for _, p in
		{
			{ -17, -3, 1.3 },
			{ -20.5, 0, 1 },
			{ -18.5, -7, 1.1 },
			{ 17, -3, 1.3 },
			{ 20.5, 0, 1 },
			{ 18.5, -7, 1.1 },
			{ -9, -14, 1.2 },
			{ 9, -14, 1.2 },
			{ 0, -17, 1.6 },
		}
	do
		add(props, { kind = "Pumpkin", pos = V3(p[1], 0, p[2]), scale = p[3] })
	end
	for _, p in { { -13, 9, 1 }, { 13, 9, 1 }, { -15, 7.5, 0.8 }, { 15, 7.5, 0.8 }, { -6, 12, 0.7 }, { 6, 12, 0.7 } } do
		add(props, { kind = "Candle", pos = V3(p[1], 0, p[2]), scale = p[3] })
	end
	add(props, { kind = "Pillar", pos = V3(-24, 0, -8), height = 20, radius = 1.6 })
	add(props, { kind = "Pillar", pos = V3(24, 0, -8), height = 20, radius = 1.6 })
	add(props, { kind = "DeadTree", pos = V3(-32, 0, -22), scale = 1.4 })
	add(props, { kind = "DeadTree", pos = V3(32, 0, -20), scale = 1.2 })
	add(props, { kind = "DeadTree", pos = V3(-44, 0, -6), scale = 1.1 })
	add(props, { kind = "DeadTree", pos = V3(44, 0, -8), scale = 1 })
	for _, g in { { -12, -11, 1.1, 0.15, -0.08 }, { -25, -1, 1.2, 0.5, 0.06 }, { 12, -12, 1, -0.2, 0.05 }, { 26, 2, 1.2, -0.4, -0.05 }, { 20, -13, 0.9, 0.1, 0.1 }, { -19, -14, 1, 0, -0.1 } } do
		add(props, { kind = "Gravestone", pos = V3(g[1], 0, g[2]), scale = g[3], yaw = g[4], tilt = g[5] })
	end
	add(props, { kind = "Fence", pos = V3(-34, 0, -30), to = V3(-8, 0, -30) })
	add(props, { kind = "Fence", pos = V3(8, 0, -30), to = V3(34, 0, -30) })
	add(props, { kind = "Mist", pos = V3(0, 0, -4), size = V3(60, 3, 40), color = RGB(150, 110, 220), rate = 7 })
	add(props, { kind = "RingLine", radius = 13.5, color = RGB(190, 90, 255), width = 0.3 })
	add(props, { kind = "RingLine", radius = 19, color = RGB(255, 140, 40), width = 0.3 })
	add(props, { kind = "Moon", pos = V3(-45, 75, -150), size = 40, color = RGB(255, 245, 200) })
	add(props, { kind = "Spotlight", pos = V3(-16, 20, -10), aim = V3(0, 2, 0), color = RGB(170, 80, 255) })
	add(props, { kind = "Spotlight", pos = V3(16, 20, -10), aim = V3(0, 2, 0), color = RGB(255, 140, 40) })

	Themes.Halloween = {
		Display = "Halloween",
		Lighting = {
			ClockTime = 0,
			Brightness = 0.6,
			Ambient = RGB(50, 35, 90),
			OutdoorAmbient = RGB(60, 45, 110),
			FogColor = RGB(25, 15, 45),
			FogStart = 60,
			FogEnd = 220,
		},
		Atmosphere = { Density = 0.3, Offset = 0.2, Color = RGB(120, 80, 200), Decay = RGB(60, 30, 100), Glare = 0, Haze = 1 },
		Bloom = { Intensity = 0.5, Size = 24, Threshold = 1 },
		ColorCorrection = { Saturation = 0.2, Contrast = 0.12, TintColor = RGB(235, 225, 255) },
		Depth = { FarIntensity = 0.3, FocusDistance = 30, InFocusRadius = 28, NearIntensity = 0 },
		Ground = { Color = RGB(18, 14, 28), Material = Enum.Material.Slate },
		Floor = { Radius = 22, Thickness = 2, Color = RGB(60, 25, 110), Material = Enum.Material.Marble, RingColor = RGB(200, 100, 255) },
		Props = props,
		Camera = { Pos = V3(0, 4, 26), Look = V3(0, 0, 0), Fov = 50, Orbit = false },
	}
end

----------------------------------------------------------------------------------------------------
-- DiscoNeon: dark glossy stage, glowing floor tiles, disco ball and coloured spotlights
----------------------------------------------------------------------------------------------------
do
	local props = {}
	local colors = { RGB(255, 0, 170), RGB(0, 255, 230), RGB(255, 230, 0) }
	neonRing(props, 16, 15, colors, 3.4)
	neonRing(props, 8, 8, colors, 2.6, math.pi / 8)
	add(props, { kind = "RingLine", radius = 18, color = RGB(255, 0, 170), width = 0.3 })
	add(props, { kind = "RingLine", radius = 11, color = RGB(0, 255, 230), width = 0.3 })
	add(props, { kind = "DiscoBall", pos = V3(0, 24, -2), size = 6 })
	add(props, { kind = "Spotlight", pos = V3(-20, 24, -12), aim = V3(0, 2, 0), color = RGB(255, 0, 170) })
	add(props, { kind = "Spotlight", pos = V3(20, 24, -12), aim = V3(0, 2, 0), color = RGB(0, 255, 230) })
	add(props, { kind = "Spotlight", pos = V3(-20, 24, 12), aim = V3(0, 2, 0), color = RGB(255, 230, 0) })
	add(props, { kind = "Spotlight", pos = V3(20, 24, 12), aim = V3(0, 2, 0), color = RGB(120, 255, 80) })
	add(props, { kind = "Pillar", pos = V3(-24, 0, -10), height = 22, radius = 1, color = RGB(255, 0, 170), neon = true })
	add(props, { kind = "Pillar", pos = V3(24, 0, -10), height = 22, radius = 1, color = RGB(0, 255, 230), neon = true })

	Themes.DiscoNeon = {
		Display = "Disco Neon",
		Lighting = {
			ClockTime = 0,
			Brightness = 0.2,
			Ambient = RGB(10, 5, 30),
			OutdoorAmbient = RGB(15, 10, 40),
			FogColor = RGB(10, 0, 30),
			FogStart = 100,
			FogEnd = 300,
		},
		Atmosphere = { Density = 0.15, Offset = 0, Color = RGB(60, 0, 120), Decay = RGB(20, 0, 60), Glare = 0, Haze = 0.5 },
		Bloom = { Intensity = 1.2, Size = 30, Threshold = 0.8 },
		ColorCorrection = { Saturation = 0.3, Contrast = 0.15, TintColor = RGB(255, 245, 255) },
		Depth = { FarIntensity = 0.2, FocusDistance = 30, InFocusRadius = 30, NearIntensity = 0 },
		Ground = { Color = RGB(8, 6, 16), Material = Enum.Material.SmoothPlastic },
		Floor = { Radius = 20, Thickness = 2, Color = RGB(15, 10, 30), Material = Enum.Material.SmoothPlastic, RingColor = RGB(0, 255, 230) },
		Props = props,
		Camera = { Pos = V3(0, 4, 26), Look = V3(0, 0, 0), Fov = 50, Orbit = false },
	}
end

----------------------------------------------------------------------------------------------------
-- Simple: bright, plain platform; good for testing and for a clean look
----------------------------------------------------------------------------------------------------
do
	local props = {}
	add(props, { kind = "Pillar", pos = V3(-22, 0, -8), height = 12, radius = 1.2, color = RGB(235, 235, 240) })
	add(props, { kind = "Pillar", pos = V3(22, 0, -8), height = 12, radius = 1.2, color = RGB(235, 235, 240) })
	add(props, { kind = "RingLine", radius = 12, color = RGB(80, 160, 255), width = 0.3 })

	Themes.Simple = {
		Display = "Simple",
		Lighting = {
			ClockTime = 14,
			Brightness = 2.5,
			Ambient = RGB(140, 140, 150),
			OutdoorAmbient = RGB(160, 170, 190),
			FogColor = RGB(200, 210, 230),
			FogStart = 200,
			FogEnd = 1000,
		},
		Atmosphere = { Density = 0.2, Offset = 0, Color = RGB(199, 210, 230), Decay = RGB(106, 112, 125), Glare = 0, Haze = 0 },
		Bloom = { Intensity = 0.2, Size = 24, Threshold = 2 },
		Ground = { Color = RGB(120, 180, 110), Material = Enum.Material.Grass },
		Floor = { Radius = 20, Thickness = 2, Color = RGB(230, 230, 235), Material = Enum.Material.SmoothPlastic, RingColor = RGB(80, 160, 255) },
		Props = props,
		Camera = { Pos = V3(0, 4, 26), Look = V3(0, 0, 0), Fov = 50, Orbit = false },
	}
end

return Themes
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="238">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="239">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="ModuleScript" referent="240">
        <Properties>
          <string name="Name">CameraRig</string>
          <ProtectedString name="Source"><![CDATA[-- Camera offsets (orbit, tilt, zoom) applied on top of a theme's camera. Pure maths with no input
-- handling, so it can be tested. StreamCamera.client.luau feeds it joystick / keyboard / mouse input.
local CameraRig = {}

CameraRig.yaw = 0 -- radians, positive moves the camera to the right around the stage
CameraRig.pitch = 0 -- radians, positive raises the camera
CameraRig.zoom = 1 -- distance multiplier, below 1 is closer

local MIN_ZOOM, MAX_ZOOM = 0.35, 2.5
local MIN_PITCH, MAX_PITCH = -0.25, 1.0

function CameraRig.nudge(deltaYaw: number, deltaPitch: number, zoomFactor: number)
	CameraRig.yaw += deltaYaw
	CameraRig.pitch = math.clamp(CameraRig.pitch + deltaPitch, MIN_PITCH, MAX_PITCH)
	CameraRig.zoom = math.clamp(CameraRig.zoom * zoomFactor, MIN_ZOOM, MAX_ZOOM)
end

function CameraRig.reset()
	CameraRig.yaw = 0
	CameraRig.pitch = 0
	CameraRig.zoom = 1
end

-- Camera frame for a theme camera (position, lookAt) plus the current offsets.
function CameraRig.compute(position: Vector3, lookAt: Vector3): CFrame
	local offset = (position - lookAt) * CameraRig.zoom
	offset = CFrame.Angles(-CameraRig.pitch, 0, 0):VectorToWorldSpace(offset)
	offset = CFrame.Angles(0, CameraRig.yaw, 0):VectorToWorldSpace(offset)
	return CFrame.lookAt(lookAt + offset, lookAt)
end

return CameraRig
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="241">
        <Properties>
          <string name="Name">DevPanel</string>
          <ProtectedString name="Source"><![CDATA[-- On-screen test panel for the game's creator and for Studio. It can be collapsed (arrow button) or hidden
-- completely (press H) so it never shows up in the stream. It only sends requests; the server re-checks
-- permission and validates everything. For live control use the local bridge app instead.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local CameraRig = require(script.Parent.CameraRig)

local player = Players.LocalPlayer
if not (RunService:IsStudio() or player.UserId == game.CreatorId) then
	return
end

local remote = ReplicatedStorage:WaitForChild("StageDevAction", 30)
if not remote then
	return
end

local gui = Instance.new("ScreenGui")
gui.Name = "StageDevPanel"
gui.ResetOnSpawn = false
gui.DisplayOrder = 100
gui.Parent = player:WaitForChild("PlayerGui")

local panel = Instance.new("Frame")
panel.Position = UDim2.fromOffset(10, 60)
panel.Size = UDim2.fromOffset(230, 0)
panel.AutomaticSize = Enum.AutomaticSize.Y
panel.BackgroundColor3 = Color3.fromRGB(20, 20, 28)
panel.BackgroundTransparency = 0.15
panel.BorderSizePixel = 0
panel.Parent = gui

local padding = Instance.new("UIPadding")
padding.PaddingTop = UDim.new(0, 6)
padding.PaddingBottom = UDim.new(0, 6)
padding.PaddingLeft = UDim.new(0, 8)
padding.PaddingRight = UDim.new(0, 8)
padding.Parent = panel

local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 6)
layout.SortOrder = Enum.SortOrder.LayoutOrder
layout.Parent = panel

-- The part that collapses
local body = Instance.new("Frame")
body.LayoutOrder = 2
body.Size = UDim2.new(1, 0, 0, 0)
body.AutomaticSize = Enum.AutomaticSize.Y
body.BackgroundTransparency = 1
body.Parent = panel

local bodyLayout = Instance.new("UIListLayout")
bodyLayout.Padding = UDim.new(0, 6)
bodyLayout.SortOrder = Enum.SortOrder.LayoutOrder
bodyLayout.Parent = body

local header = Instance.new("TextButton")
header.LayoutOrder = 1
header.Size = UDim2.new(1, 0, 0, 26)
header.BackgroundTransparency = 1
header.Font = Enum.Font.GothamBold
header.TextSize = 14
header.TextXAlignment = Enum.TextXAlignment.Left
header.TextColor3 = Color3.fromRGB(220, 220, 240)
header.Parent = panel

local function setCollapsed(collapsed: boolean)
	body.Visible = not collapsed
	header.Text = (if collapsed then "▸ " else "▾ ") .. "Stage panel  (H hides)"
end
header.Activated:Connect(function()
	setCollapsed(body.Visible)
end)
setCollapsed(false)

UserInputService.InputBegan:Connect(function(input, processed)
	if not processed and input.KeyCode == Enum.KeyCode.H then
		gui.Enabled = not gui.Enabled
	end
end)

local order = 0
local function nextOrder(): number
	order += 1
	return order
end

local function label(text: string)
	local l = Instance.new("TextLabel")
	l.LayoutOrder = nextOrder()
	l.Size = UDim2.new(1, 0, 0, 18)
	l.BackgroundTransparency = 1
	l.Font = Enum.Font.GothamBold
	l.TextSize = 13
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.TextColor3 = Color3.fromRGB(170, 170, 200)
	l.Text = text
	l.Parent = body
end

local function button(parent: Instance, text: string, onClick: () -> ()): TextButton
	local b = Instance.new("TextButton")
	b.LayoutOrder = nextOrder()
	b.Size = UDim2.new(1, 0, 0, 28)
	b.BackgroundColor3 = Color3.fromRGB(90, 60, 200)
	b.BorderSizePixel = 0
	b.Font = Enum.Font.Gotham
	b.TextSize = 14
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Text = text
	b.Parent = parent
	b.Activated:Connect(onClick)
	return b
end

-- Gift / theme names are published by DevCommands as "Name|Detail,Name|Detail"
local function entries(attribute: string): { { string } }
	local result = {}
	for entry in string.gmatch(Workspace:GetAttribute(attribute) or "", "[^,]+") do
		local name, detail = string.match(entry, "^(.-)|(.*)$")
		table.insert(result, { name or entry, detail or "" })
	end
	return result
end

label("Join")
local box = Instance.new("TextBox")
box.LayoutOrder = nextOrder()
box.Size = UDim2.new(1, 0, 0, 28)
box.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
box.BorderSizePixel = 0
box.Font = Enum.Font.Gotham
box.TextSize = 14
box.TextColor3 = Color3.new(1, 1, 1)
box.PlaceholderText = "Roblox username"
box.Text = ""
box.ClearTextOnFocus = false
box.Parent = body
button(body, "Join stage", function()
	remote:FireServer("join", box.Text)
end)

label("Gifts")
for _, gift in entries("StageGiftNames") do
	button(body, if gift[2] ~= "" then gift[1] .. " · " .. gift[2] else gift[1], function()
		remote:FireServer("gift", gift[1])
	end)
end

label("Theme")
for _, theme in entries("StageThemeNames") do
	button(body, theme[1], function()
		remote:FireServer("theme", theme[1])
	end)
end

label("Camera")
local cameraRow = Instance.new("Frame")
cameraRow.LayoutOrder = nextOrder()
cameraRow.Size = UDim2.new(1, 0, 0, 28)
cameraRow.BackgroundTransparency = 1
cameraRow.Parent = body
local rowLayout = Instance.new("UIListLayout")
rowLayout.FillDirection = Enum.FillDirection.Horizontal
rowLayout.SortOrder = Enum.SortOrder.LayoutOrder
rowLayout.Padding = UDim.new(0, 4)
rowLayout.Parent = cameraRow

for _, control in
	{
		{ "◀", -0.2, 0, 1 },
		{ "▶", 0.2, 0, 1 },
		{ "▲", 0, 0.12, 1 },
		{ "▼", 0, -0.12, 1 },
		{ "＋", 0, 0, 0.85 },
		{ "－", 0, 0, 1.18 },
		{ "⟲", nil, nil, nil },
	}
do
	local b = button(cameraRow, control[1], function()
		if control[2] == nil then
			CameraRig.reset()
		else
			CameraRig.nudge(control[2], control[3], control[4])
		end
	end)
	b.Size = UDim2.new(1 / 7, -4, 1, 0)
end
]]></ProtectedString>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="242">
        <Properties>
          <string name="Name">StreamCamera</string>
          <ProtectedString name="Source"><![CDATA[-- Stage camera for the live stream. The theme sets the starting view (Workspace attributes written by
-- ThemeManager); the streamer can then move it:
--   * Gamepad:    left stick orbits / zooms, right stick orbits / tilts, triggers zoom, R3 resets
--   * Keyboard:   WASD (A/D orbit, W/S zoom), mouse: hold right button and drag, wheel zooms, R resets
--   * Touch:      the on-screen thumbstick works like WASD; the panel also has camera buttons
-- Moving the character is not needed, so its walk speed is set to 0 and the inputs steer the camera instead.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local CameraRig = require(script.Parent.CameraRig)

local player = Players.LocalPlayer

local ORBIT_SPEED = 1.4 -- radians per second at full stick
local TILT_SPEED = 1.0
local ZOOM_SPEED = 1.2 -- e-folds per second
local DEADZONE = 0.15

local function dead(value: number): number
	if math.abs(value) < DEADZONE then
		return 0
	end
	return value
end

-- The avatar of the streamer is never in shot, so keep it from wandering off when inputs are used
local function freeze(character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10)
	if humanoid and humanoid:IsA("Humanoid") then
		humanoid.WalkSpeed = 0
		humanoid.JumpHeight = 0
	end
end
player.CharacterAdded:Connect(freeze)
if player.Character then
	task.spawn(freeze, player.Character)
end

-- Mouse: hold the right button and drag to orbit/tilt, wheel to zoom
UserInputService.InputChanged:Connect(function(input, processed)
	if processed then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseMovement and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
		CameraRig.nudge(-input.Delta.X * 0.005, input.Delta.Y * 0.005, 1)
	elseif input.UserInputType == Enum.UserInputType.MouseWheel then
		CameraRig.nudge(0, 0, 0.9 ^ input.Position.Z)
	end
end)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return -- typing in a text box
	end
	if input.KeyCode == Enum.KeyCode.R or input.KeyCode == Enum.KeyCode.ButtonR3 then
		CameraRig.reset()
	end
end)

-- Right stick and triggers of the first gamepad
local function gamepad(): (Vector2, number)
	local stick = Vector2.new(0, 0)
	local zoom = 0
	for _, input in UserInputService:GetGamepadState(Enum.UserInputType.Gamepad1) do
		if input.KeyCode == Enum.KeyCode.Thumbstick2 then
			stick = Vector2.new(dead(input.Position.X), dead(input.Position.Y))
		elseif input.KeyCode == Enum.KeyCode.ButtonL2 then
			zoom += input.Position.Z -- left trigger zooms out
		elseif input.KeyCode == Enum.KeyCode.ButtonR2 then
			zoom -= input.Position.Z -- right trigger zooms in
		end
	end
	return stick, zoom
end

RunService:BindToRenderStep("StageCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
	local position = Workspace:GetAttribute("StageCamPos")
	local lookAt = Workspace:GetAttribute("StageCamLook")
	local camera = Workspace.CurrentCamera
	if not camera or typeof(position) ~= "Vector3" or typeof(lookAt) ~= "Vector3" then
		return -- no theme yet: leave the default camera alone
	end

	camera.CameraType = Enum.CameraType.Scriptable
	camera.FieldOfView = Workspace:GetAttribute("StageCamFov") or 50

	-- Movement input (WASD, left stick, touch thumbstick) in camera space: x = right, z = back
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	local move = Vector3.new(0, 0, 0)
	if humanoid then
		move = camera.CFrame:VectorToObjectSpace(humanoid.MoveDirection)
	end
	local stick, trigger = gamepad()

	local orbit = move.X + stick.X
	local tilt = stick.Y
	local zoomInput = move.Z + trigger -- forward (negative) zooms in
	CameraRig.nudge(orbit * ORBIT_SPEED * dt, tilt * TILT_SPEED * dt, math.exp(zoomInput * ZOOM_SPEED * dt))
	if Workspace:GetAttribute("StageCamOrbit") then
		CameraRig.nudge(0.15 * dt, 0, 1) -- slow automatic orbit
	end

	camera.CFrame = CameraRig.compute(position, lookAt)
end)
]]></ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>