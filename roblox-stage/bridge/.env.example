# TikTok account that is LIVE right now (without @)
TIKTOK_USERNAME=your_tiktok_name

# Roblox Open Cloud (create an API key with "Messaging Service: publish" for your experience)
ROBLOX_UNIVERSE_ID=0
ROBLOX_API_KEY=your_open_cloud_key
ROBLOX_TOPIC=TikTokStage

# Behaviour
JOIN_COOLDOWN_SEC=60
MAX_GIFT_REPEAT=5
SEND_INTERVAL_MS=300
